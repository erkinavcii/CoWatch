# Co-Watch settings. Copy this file to .env and change what you need.

PORT=8000
# 1 = share over HTTPS with Tailscale Serve when Tailscale is running (needed for friends'
# camera and microphone); the server then listens only on 127.0.0.1. 0 = plain http links.
TAILSCALE_SERVE=1
# Empty HOST = 127.0.0.1 with Tailscale Serve, 0.0.0.0 without
# HOST=
# Empty ACCESS_KEY = generated once and kept in data/access_key.txt
# ACCESS_KEY=

# ---- Torrent ----
# KB/s. Keeps the torrent from eating the upload your friend streams from. 0 = no limit.
TORRENT_UPLOAD_LIMIT=64
# HELPER_PORT=8890

# ---- Video ----
# 0 = send every H.264 file as it is. With a slow upload set e.g. 6000:
# heavier files are then converted to TRANSCODE_KBPS.
MAX_COPY_KBPS=0
TRANSCODE_KBPS=5000
# libx264 (CPU) · h264_nvenc (NVIDIA) · h264_qsv (Intel) · h264_amf (AMD) · h264_videotoolbox (Mac)
VIDEO_ENCODER=libx264
MAX_HEIGHT=1080
AUDIO_KBPS=192
# Evens out loud explosions and quiet dialogue. Leave empty to turn off.
AUDIO_FILTER=dynaudnorm=f=500:g=15
HLS_TIME=4
# FFMPEG=ffmpeg
# FFPROBE=ffprobe

# ---- OpenSubtitles (optional) ----
# API key: https://www.opensubtitles.com/consumers  (a free account allows about 20 downloads a day)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Co-Watch settings for developers. Most of them are on the settings page (Share card > Settings),
# kept in data/settings.json; a line here wins over the page and shows locked there, so the
# ones the page covers are commented out. Copy this file to .env and change what you need.

# PORT=8000
# 1 = share over HTTPS with Tailscale Serve when Tailscale is running (needed for friends'
# camera and microphone); the server then listens only on 127.0.0.1. 0 = plain http links.
# TAILSCALE_SERVE=1
# 1 = Tailscale Funnel instead of Serve: the same HTTPS link, open to the whole internet, so a
# friend needs only a browser (no Tailscale). The link key is then the room's only lock.
# Funnel has a bandwidth limit Tailscale does not publish; try a film before relying on it.
# TAILSCALE_FUNNEL=0
# Empty HOST = 127.0.0.1 with Tailscale Serve, 0.0.0.0 without
# HOST=
# Empty ACCESS_KEY = generated once and kept in data/access_key.txt
# ACCESS_KEY=

# ---- Film folders ----
# Separated by ";". Their videos are listed under "Film folder" for the host and for friends the
# host trusts (click their name at the top). Hidden folders are skipped.
# LIBRARY_DIRS=D:\Films;E:\Series
# everyone = anyone with the link opens and closes films (torrents, add-on sources);
# trusted = only the host and trusted friends. Play, pause and seek stay open to everyone.
# MEDIA_CONTROL=everyone

# ---- Add-ons ----
# 1 = Cinemeta (catalogs, details) and Public Domain Movies come built in. Add-ons the host adds
# under Browse > Add-ons are kept in data/addons.json (not in git). 0 = only those.
ADDONS_BUILTIN=1

# ---- Voice ----
# Comma-separated stun: addresses. Empty = voice goes only between the viewers' own
# addresses (the Tailscale ones among them), with no outside server involved.
# With TAILSCALE_FUNNEL=1 and this empty, Cloudflare's free STUN server is used.
# ICE_SERVERS=stun:stun.l.google.com:19302

# ---- Torrent ----
# KB/s. Keeps the torrent from eating the upload your friend streams from. 0 = no limit.
# TORRENT_UPLOAD_LIMIT=64
# HELPER_PORT=8890

# ---- Video ----
# 0 = send every H.264 file as it is (default; 5500 on Funnel). With a slow upload set e.g. 6000:
# heavier files are then converted to TRANSCODE_KBPS.
# MAX_COPY_KBPS=0
# TRANSCODE_KBPS=5000
# libx264 (CPU) · h264_nvenc (NVIDIA) · h264_qsv (Intel) · h264_amf (AMD) · h264_videotoolbox (Mac)
VIDEO_ENCODER=libx264
MAX_HEIGHT=1080
AUDIO_KBPS=192
# Evens out loud explosions and quiet dialogue. Leave empty to turn off.
AUDIO_FILTER=dynaudnorm=f=500:g=15
HLS_TIME=4
# FFMPEG=ffmpeg
# FFPROBE=ffprobe

# ---- OpenSubtitles (optional) ----
# API key: https://www.opensubtitles.com/consumers  (a free account allows about 20 downloads a day)
# OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=
